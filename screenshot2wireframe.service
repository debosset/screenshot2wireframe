[Unit]
Description=Screenshot to Balsamiq Wireframe
After=network.target

[Service]
WorkingDirectory=/var/www/vhosts/VOTRE_DOMAINE/screenshot2wireframe
ExecStart=/var/www/vhosts/VOTRE_DOMAINE/screenshot2wireframe/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8001
Restart=always
User=www-data
Group=www-data

[Install]
WantedBy=multi-user.target
